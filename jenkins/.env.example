# Salin file ini menjadi .env lalu isi nilainya:  copy .env.example .env
# File .env TIDAK boleh di-commit ke GitHub (sudah ada di .gitignore).

# ---- Login Jenkins ----
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=ganti-password-ini

# ---- GitHub (Personal Access Token classic: scope repo + admin:repo_hook) ----
GITHUB_USERNAME=username-github-kalian
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPO_URL=https://github.com/username-github-kalian/link-hub-kelompok-f.git

# ---- ngrok (https://dashboard.ngrok.com) ----
NGROK_AUTHTOKEN=isi-authtoken-ngrok
# Opsional tapi disarankan: domain statis gratis (Dashboard -> Domains), tanpa https://
NGROK_URL=
# Opsional: URL publik Jenkins (mis. https://nama-anda.ngrok-free.app/)
JENKINS_PUBLIC_URL=http://localhost:8080/
